#!/bin/bash

# Colors
GREEN="\e[1;32m"
CYAN="\e[1;36m"
RED="\e[1;31m"
YELLOW="\e[1;33m"
GRAY="\e[0;37m"
BOLD="\e[1m"
RESET="\e[0m"

print_header() {
    clear
    echo -e "${CYAN}┌──────────────────────────────────────────────────────────────────┐${RESET}"
    echo -e "${CYAN}│                    🚀 ${BOLD}Developer Launcher 🚀${RESET}${CYAN}                      │${RESET}"
    echo -e "${CYAN}└──────────────────────────────────────────────────────────────────┘${RESET}"
    echo -e "\n ${YELLOW}Tip:${RESET} TAB autocomplete | SPACE select | ENTER confirm | Ctrl+D exit\n"
}

print_header


while true; do
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────${RESET}"
    echo -e " ${GRAY}📍 $(pwd)${RESET}"
    
    if ! read -e -p "$(echo -e " ${GREEN}📁 Directory:${RESET} ")" dir; then
        echo -e "\n ${CYAN}👋 Exiting...${RESET}\n"
        sleep 1
        exit
    fi
    
    if [ -z "$dir" ]; then
        echo -e " ${RED}❌ No directory entered${RESET}"
        # echo -e "${CYAN}────────────────────────────────────────────────────────────────────${RESET}"
        continue
    fi
    
    if cd "$dir" 2>/dev/null; then
        echo -e "${CYAN}────────────────────────────────────────────────────────────────────${RESET}"
        echo -e "\n ${CYAN}🚀 Opening:${RESET} ${BOLD}$(pwd)${RESET}\n"
        
        options=$(gum choose --no-limit \
            --cursor.foreground="#00ffff" \
            --selected.foreground="#00ff00" \
            --selected-prefix="✓ " \
            --cursor-prefix=" " \
            --selected="󰅨 OpenCode" \
            " Open terminal" \
            "󰨞 VSCode" \
            "󰅨 OpenCode"
        )
        
        if [[ -n "$options" ]]; then
            [[ "$options" == *" Open terminal"* ]] && \
            setsid alacritty --working-directory "$(pwd)" \
            >/dev/null 2>&1 &
            sleep 0.25
            
            [[ "$options" == *"󰅨 OpenCode"* ]] && \
            setsid alacritty \
            --working-directory "$(pwd)" \
            -e opencode "$(pwd)" \
            >/dev/null 2>&1 &
            sleep 0.25
            
            [[ "$options" == *"󰨞 VSCode"* ]] && \
            i3-msg "workspace 2; exec code \"$(pwd)\""
            sleep 0.25
            exit
        else
            echo -e " ${RED}❌ No option selected${RESET}"
            sleep 0.5
        fi
    else
        # Resolve full path for display
        if [[ "$dir" = /* ]]; then
            full_path="$dir"
        else
            full_path="$(pwd)/$dir"
        fi
        
        echo -e " ${RED}❌ Does not exist:${RESET} ${BOLD}$full_path${RESET}"
        echo -e "${CYAN}────────────────────────────────────────────────────────────────────${RESET}"
    fi
done
