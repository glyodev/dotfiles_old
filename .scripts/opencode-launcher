#!/bin/bash

# Colores
GREEN="\e[1;32m"
CYAN="\e[1;36m"
RED="\e[1;31m"
YELLOW="\e[1;33m"
GRAY="\e[0;37m"
BOLD="\e[1m"
RESET="\e[0m"

print_header() {
    clear
    echo -e "${CYAN}┌─────────────────────────────────────────────────────────┐${RESET}"
    echo -e "${CYAN}│                🚀 ${BOLD}OpenCode Launcher 🚀${RESET}${CYAN}                  │${RESET}"
    echo -e "${CYAN}└─────────────────────────────────────────────────────────┘${RESET}"
    echo -e "\n ${YELLOW}Tip:${RESET} TAB autocompleta | Enter vacío o Ctrl+D para salir\n"
}

print_header

echo -e "${CYAN}───────────────────────────────────────────────────────────${RESET}"
while true; do
    echo -e " ${GRAY}📍 $(pwd)${RESET}"

		if ! read -e -p "$(echo -e " ${GREEN}📁 Directorio:${RESET} ")" dir; then
        echo -e "\n ${CYAN}👋 Saliendo...${RESET}\n"
        sleep 1
        exit
    fi

    if [ -z "$dir" ]; then
        echo -e " ${RED}❌ Ningún directorio ingresado${RESET}"
        echo -e "${CYAN}───────────────────────────────────────────────────────────${RESET}"
        continue
    fi

    if cd "$dir" 2>/dev/null; then
        echo -e "\n ${CYAN}🚀 Abriendo:${RESET} ${BOLD}$(pwd)${RESET}\n"
        sleep 0.5
        exec opencode "$(pwd)"
		else
        # Resolver ruta completa para mostrar
        if [[ "$dir" = /* ]]; then
            full_path="$dir"
        else
            full_path="$(pwd)/$dir"
        fi

        echo -e " ${RED}❌ No existe: ${BOLD}$full_path${RESET}"
        echo -e "${CYAN}───────────────────────────────────────────────────────────${RESET}"
    fi
done
